{
  "name": "whatsapp-bridge-mcp",
  "version": "0.1.0",
  "description": "Self-healing WhatsApp MCP server for Claude and other MCP clients: read chats, search, and send messages with built-in safety limits.",
  "type": "module",
  "bin": {
    "whatsapp-bridge-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/transport/wwebjs/pins.json','dist/transport/wwebjs/pins.json')\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "guard": "node scripts/guard-protected-paths.mjs",
    "canary": "node dist/index.js canary --profile canary",
    "prepublishOnly": "npm run check && npm run build",
    "version": "node scripts/sync-version.mjs && git add .claude-plugin/plugin.json manifest.json",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "keywords": [
    "whatsapp",
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "whatsapp-web.js",
    "baileys"
  ],
  "author": "pranjal-singla-15",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranjal-singla-15/whatsapp-bridge-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/pranjal-singla-15/whatsapp-bridge-mcp/issues"
  },
  "homepage": "https://github.com/pranjal-singla-15/whatsapp-bridge-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "baileys": "7.0.0-rc14",
    "pino": "10.4.0",
    "qrcode-terminal": "0.12.0",
    "whatsapp-web.js": "1.34.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
